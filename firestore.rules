rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin check ──────────────────────────────────────────────────────────
    // Uses the verified email on the Firebase ID token — cannot be spoofed
    // by client-side data. email_verified must be true to guard against
    // unverified accounts with that address.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "detlaffcameron@gmail.com"
          && request.auth.token.email_verified == true;
    }

    // Ghost UIDs are always "ghost_" followed by alphanumeric chars.
    function isGhostUid(uid) {
      return uid.matches("ghost_[a-z0-9]+");
    }

    // ── Private save data ────────────────────────────────────────────────────
    // Normal players: read/write their own document only.
    // Admin: additionally read/write any ghost_ document.
    // The two conditions are OR'd in a single allow rule — Firestore
    // evaluates multiple allow rules as OR, but combining them explicitly
    // is cleaner and avoids rule-ordering surprises.
    match /users/{uid} {
      allow read, write: if request.auth != null
          && (request.auth.uid == uid || (isAdmin() && isGhostUid(uid)));
    }

    // ── Public leaderboard snapshots ─────────────────────────────────────────
    // Any signed-in player can read the whole collection (powers the
    // leaderboard and other players' profile views).
    // Write: own document OR admin writing a ghost_ document.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && (request.auth.uid == uid || (isAdmin() && isGhostUid(uid)));
    }

    // ── Global rare-drop announcements ────────────────────────────────────────
    // Append-only log powering the live ticker. Any signed-in player may
    // read and create (their own uid, max 300-char text). Nobody may edit
    // or delete once posted.
    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300;
      allow update, delete: if false;
    }

    // ── Everything else locked down ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
